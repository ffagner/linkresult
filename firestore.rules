rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Usuários criados antes do campo `status` existir não têm a chave —
    // tratamos a ausência como ativo, e só bloqueia quando for 'inativo'.
    function isAtivo() {
      return !('status' in userData()) || userData().status != 'inativo';
    }

    function isAdmin() {
      return userData().role == 'admin' && isAtivo();
    }

    function isPedagogico() {
      return userData().role == 'pedagogico' && isAtivo();
    }

    function isMunicipio() {
      return userData().role == 'municipio' && isAtivo();
    }

    function getMunicipioId() {
      return userData().municipioId;
    }

    match /municipios/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /avaliacoes/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /series/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /relatorios/{id} {
      allow read, write: if isAdmin();

      allow read: if isPedagogico();
      allow update: if isPedagogico()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'liberado', 'liberadoEm', 'liberadoPor', 'updatedAt',
              'entregueEm', 'entreguePor', 'entreguePorNome', 'historico'
            ])
        // Sem Cloud Functions (plano Spark) não dá pra garantir imutabilidade
        // das entradas antigas — só que o histórico nunca encolhe.
        && request.resource.data.historico.size() >= resource.data.get('historico', []).size();

      allow read: if isMunicipio()
        && resource.data.municipioId == getMunicipioId()
        && resource.data.liberado == true;
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow write: if isAdmin();
    }

    // Analytics de uso: registro de abertura de relatório pelo município.
    // Ver docs/PLANO-ANALYTICS.md.
    match /acessos/{id} {
      allow read: if isAdmin() || isPedagogico();

      // Município só cria, só um registro dele mesmo, com o relógio do servidor.
      allow create: if isMunicipio()
        && request.resource.data.municipioId == getMunicipioId()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.em == request.time;

      // Log de auditoria é imutável pelo app — expurgo por retenção via
      // Console/Admin SDK, não pela aplicação.
      allow update, delete: if false;
    }
  }
}
